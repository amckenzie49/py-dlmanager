# Required TorBox and WebDAV settings
TORBOX_API_KEY=replace_with_your_torbox_api_key
WEBDAV_URL=https://webdav.example.com/remote.php/dav/files/username
WEBDAV_USERNAME=replace_with_your_webdav_username
WEBDAV_PASSWORD=replace_with_your_webdav_password

# Optional settings
TORBOX_BASE_URL=https://api.torbox.app
WEBDAV_REMOTE_PATH=/downloads
DEBRID_POLL_INTERVAL_SECONDS=10
DEBRID_POLL_TIMEOUT_SECONDS=86400
FRONTEND_PORT=8080